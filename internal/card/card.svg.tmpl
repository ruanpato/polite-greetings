{{- /*
  The SVG card. Every value comes from card.view: numbers and colors are
  computed and validated in Go, and every text goes through x (XML escaping).
*/ -}}

{{define "card" -}}
<svg xmlns="http://www.w3.org/2000/svg" id="{{.ID}}" width="{{.Width}}" height="{{.Height}}" viewBox="0 0 {{.W}} {{.H}}" role="img" aria-labelledby="{{.ID}}-title" xml:lang="{{.Lang}}">
<title id="{{.ID}}-title">{{x .Title}}</title>
<style>{{template "style" .}}</style>
<rect class="bg" x=".5" y=".5" width="{{.RectW}}" height="{{.RectH}}" rx="{{.Radius}}"/>
{{if eq .Layout "compact"}}{{template "compact" .}}{{else if eq .Layout "classic"}}{{template "classic" .}}{{else}}{{template "sky" .}}{{end}}
</svg>
{{end}}

{{define "style" -}}
{{template "palette" index .Styles 0}}
{{- if .Auto}}@media (prefers-color-scheme:dark){ {{- template "palette" index .Styles 1 -}} }{{end}}
{{- if .Animate}}{{template "motion" .}}{{end}}
{{- end}}

{{define "palette" -}}
#{{.ID}} .bg{fill:#{{.P.Bg}};{{if .Border}}stroke:#{{.P.Text}};stroke-opacity:.25{{else}}stroke:none{{end}}}
{{- /**/ -}}
#{{.ID}} .a{fill:#{{.P.Accent}}}#{{.ID}} .as{stroke:#{{.P.Accent}}}#{{.ID}} .t{fill:#{{.P.Text}}}#{{.ID}} .ts{stroke:#{{.P.Text}}}#{{.ID}} .k{stroke:#{{.P.Bg}}}
{{- end}}

{{define "motion" -}}
@keyframes pg-pulse{0%{transform:scale(1);opacity:.45}70%,100%{transform:scale(2.2);opacity:0}}
{{- /**/ -}}
@keyframes pg-twinkle{0%,100%{opacity:.2}50%{opacity:1}}@keyframes pg-spin{to{transform:rotate(360deg)}}
{{- /**/ -}}
#{{.ID}} .glow{transform-box:fill-box;transform-origin:center;animation:pg-pulse 2.4s ease-out infinite}
{{- /**/ -}}
#{{.ID}} .star{animation:pg-twinkle 3s ease-in-out infinite}#{{.ID}} .s2{animation-delay:.7s}#{{.ID}} .s3{animation-delay:1.4s}#{{.ID}} .s4{animation-delay:2.1s}
{{- /**/ -}}
#{{.ID}} .rays{transform-box:fill-box;transform-origin:center;animation:pg-spin 30s linear infinite}
{{- /**/ -}}
@media (prefers-reduced-motion:reduce){#{{.ID}} *{animation:none!important}}
{{- end}}

{{define "font"}}font-family="-apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Ubuntu, sans-serif"{{end}}

{{define "icon" -}}
{{if eq .Period "morning" -}}
<g class="as" stroke-width="2.5" stroke-linecap="round" fill="none"><line x1="-21" y1="10" x2="21" y2="10"/><line x1="-12.99" y1="2.5" x2="-17.32" y2="0"/><line x1="-7.5" y1="-2.99" x2="-10" y2="-7.32"/><line x1="0" y1="-5" x2="0" y2="-10"/><line x1="7.5" y1="-2.99" x2="10" y2="-7.32"/><line x1="12.99" y1="2.5" x2="17.32" y2="0"/></g><path class="a" d="M-11 10A11 11 0 0 1 11 10Z"/>
{{- else if eq .Period "afternoon" -}}
<circle class="a" r="8.5"/><g class="as rays" stroke-width="2.5" stroke-linecap="round"><line x1="13" y1="0" x2="19" y2="0"/><line x1="9.19" y1="9.19" x2="13.44" y2="13.44"/><line x1="0" y1="13" x2="0" y2="19"/><line x1="-9.19" y1="9.19" x2="-13.44" y2="13.44"/><line x1="-13" y1="0" x2="-19" y2="0"/><line x1="-9.19" y1="-9.19" x2="-13.44" y2="-13.44"/><line x1="0" y1="-13" x2="0" y2="-19"/><line x1="9.19" y1="-9.19" x2="13.44" y2="-13.44"/></g>
{{- else -}}
<mask id="{{.ID}}-moon"><circle r="15" fill="#fff"/><circle cx="7" cy="-6" r="12.5" fill="#000"/></mask><circle class="a" r="15" mask="url(#{{.ID}}-moon)"/>
{{- end}}
{{- end}}

{{define "compact" -}}
<g transform="translate(24 24) scale(.62)">{{template "icon" .}}</g>
<text x="46" y="31" {{template "font"}} font-size="18" font-weight="600" class="a">{{x .Greeting}}</text>
{{- end}}

{{define "classic" -}}
<g transform="translate(50 50)">{{template "icon" .}}</g>
<text x="96" y="{{.GreetingY}}" {{template "font"}} font-size="28" font-weight="600" class="a">{{x .Greeting}}</text>
{{- range .Lines}}
<text x="96" y="{{.Y}}" {{template "font"}} font-size="14" class="t">{{x .Text}}</text>
{{- end}}
{{- end}}

{{define "sky" -}}
{{$s := .Sky -}}
<g transform="translate(44 46) scale(.85)">{{template "icon" .}}</g>
<text x="78" y="54" {{template "font"}} font-size="24" font-weight="600" class="a">{{x .Greeting}}</text>
{{- if $s.Time}}
<text x="416" y="52" {{template "font"}} font-size="20" font-weight="600" text-anchor="end" class="t">{{x $s.Time}}</text>
{{- end}}
{{- if $s.Zone}}
<text x="416" y="70" {{template "font"}} font-size="11" text-anchor="end" opacity=".8" class="t">{{x $s.Zone}}</text>
{{- end}}
<line x1="24" y1="150" x2="416" y2="150" class="ts" stroke-width="1.5" opacity=".35"/>
{{if $s.Day -}}
<path class="a" opacity=".12" d="{{$s.Fill}}"/>
<path class="as" fill="none" stroke-width="2.5" stroke-linecap="round" d="{{$s.ArcDone}}"/>
<path class="ts" fill="none" stroke-width="1.5" stroke-dasharray="4 6" opacity=".5" d="{{$s.ArcLeft}}"/>
<circle class="a glow" cx="{{$s.SunX}}" cy="{{$s.SunY}}" r="7" opacity=".3"/>
<circle class="a k" stroke-width="2" cx="{{$s.SunX}}" cy="{{$s.SunY}}" r="6.5"/>
{{- else if $s.MidnightSun -}}
<path class="as" fill="none" stroke-width="2.5" stroke-linecap="round" d="{{$s.ArcFull}}"/>
{{- else -}}
<path class="ts" fill="none" stroke-width="1.5" stroke-dasharray="4 6" opacity=".45" d="{{$s.ArcFull}}"/>
<circle class="t star s1" cx="118" cy="112" r="1.6"/><circle class="t star s2" cx="176" cy="96" r="1.2"/><circle class="t star s3" cx="262" cy="104" r="1.6"/><circle class="t star s4" cx="318" cy="122" r="1.2"/>
{{- end}}
{{- if $s.Ends}}
<circle class="a" cx="40" cy="150" r="3"/><circle class="a" cx="400" cy="150" r="3"/>
{{- end}}
{{- if $s.Rise}}
<text x="40" y="174" {{template "font"}} font-size="12" class="t">{{x $s.Rise}}</text>
<text x="400" y="174" {{template "font"}} font-size="12" text-anchor="end" class="t">{{x $s.Set}}</text>
{{- end}}
{{- if $s.Center}}
<text x="220" y="174" {{template "font"}} font-size="12" text-anchor="middle" opacity=".8" class="t">{{x $s.Center}}</text>
{{- end}}
{{- end}}
